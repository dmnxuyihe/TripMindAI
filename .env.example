# Copy as .env (do not commit your .env file); local PostgreSQL 15+
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/travel_agent

# Alibaba Cloud Model Studio / Qwen. REAL AI ONLY: no fake demo AI.
# IMPORTANT: use the base URL for the same region/workspace as your API key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen-plus,qwen-max
DEFAULT_MODEL=qwen-plus
MODEL_TIMEOUT_SECONDS=45
AGENT_MAX_STEPS=4

# AMap Web Service key (NOT JS API key). Required for REAL POI discovery and maps.
AMAP_WEB_KEY=
AMAP_TIMEOUT_SECONDS=12
POI_CACHE_HOURS=72

HOST=127.0.0.1
PORT=8000
