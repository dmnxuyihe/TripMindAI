# Copy as .env (do not commit your .env file); PostgreSQL 15+ or SQLite
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/travel_agent
# SQLite 备选：DATABASE_URL=sqlite:///./tripmind.sqlite3

# OpenAI 兼容大模型服务（真实调用，无本地伪 AI）。
# DASHSCOPE_* 是历史变量名；BASE_URL 必须与所用服务/地域一致，末尾带 /v1。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen-plus,qwen-max
DEFAULT_MODEL=qwen-plus
MODEL_TIMEOUT_SECONDS=45
# 一次对话的总时间预算（多轮工具调用累加时的兜底）
AGENT_TOTAL_TIMEOUT_SECONDS=90
AGENT_MAX_STEPS=4

# AMap Web Service key (NOT JS API key). Required for REAL POI discovery and maps.
AMAP_WEB_KEY=
AMAP_TIMEOUT_SECONDS=12

# 前端地图用的高德 JS API key（服务平台选「Web端(JS API)」，并在控制台把它绑定到
# http://127.0.0.1:8000 与 http://localhost:8000，否则会提示 INVALID_USER_DOMAIN）。
# 与上面的 Web 服务 key 是两套凭据；留空则前端自动回退到开源底图。
AMAP_JS_KEY=
# JS API 2.0 的安全密钥（控制台「安全密钥」生成）；部分地区/插件需要它才能正常出图。
AMAP_JS_SECURITY_CODE=
# 跨城道路距离的总预算；超时只降级为直线距离，不拖慢主流程
AMAP_INTERCITY_BUDGET_SECONDS=3
# 景点之间道路轨迹的取数预算（排程与地图共用同一份缓存，成功一次后复用）
AMAP_LEGS_BUDGET_SECONDS=5
POI_CACHE_HOURS=72

HOST=127.0.0.1
PORT=8000
